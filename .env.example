# ===================== General =====================
NODE_ENV=production
BASE_URL=https://YOUR-DOMAIN.example
FRONTEND_URL=https://YOUR-DOMAIN.example

# ===================== Database =====================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=parsaping
POSTGRES_USER=parsaping
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://parsaping:change_me_strong_password@db:5432/parsaping

# ===================== Auth / Security =====================
# با: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_random_64_char_secret
JWT_REFRESH_SECRET=replace_with_another_random_64_char_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# کلید AES-256 برای رمزنگاری کلید خصوصی WireGuard در دیتابیس (32 بایت -> base64)
# با: openssl rand -base64 32
ENCRYPTION_KEY=replace_with_32_byte_base64_key

COOKIE_SECURE=true

# ===================== Admin Bootstrap =====================
# فقط برای اولین اجرای seed استفاده می‌شود؛ در کد هاردکد نیست.
ADMIN_DEFAULT_EMAIL=admin@yourdomain.example
ADMIN_DEFAULT_PASSWORD=change_me_before_first_run

# ===================== WireGuard =====================
# اگر روی این هاست wg-tools و دسترسی NET_ADMIN نیست، true بگذار
WG_SIMULATED=true
WG_DEFAULT_MTU=1420
WG_DEFAULT_DNS=1.1.1.1
WG_DEFAULT_PORT=51820
WG_CLIENT_IP_RANGE=10.66.0.0/16

# ===================== Rate limiting =====================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ===================== Ports =====================
BACKEND_PORT=4000
FRONTEND_PORT=3000
